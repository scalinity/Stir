# Stir ops SPA — Supabase project credentials.
# Copy this file to ops/.env (gitignored) and fill in real values from
# the Supabase dashboard for the project the ops console manages.

VITE_SUPABASE_URL=https://<your-supabase-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<paste-anon-key-from-supabase-dashboard>
