# =============================================================================
# Stir — .gitignore
# Public-safe: treat this repo as potentially public.
# If a secret is committed by mistake, rotate the key immediately — git history
# is permanent.
# =============================================================================

# -----------------------------------------------------------------------------
# Secrets & environment
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.sample
*.local
secrets.json
secrets.plist
Secrets.swift
Secrets.xcconfig

# iOS xcconfig holding SUPABASE_URL, anon key, RevenueCat, PostHog, Sentry DSN.
# Commit Config.xcconfig.example as the template. (Step-5 review fix: the
# negation line previously referenced `Config.example.xcconfig` — wrong
# filename order; harmless today because the suffix-form doesn't match
# line 23 anyway, but the stale negation was misleading.)
Config.xcconfig
!Config.xcconfig.example

# -----------------------------------------------------------------------------
# iOS / Apple signing & provisioning (NEVER commit)
# -----------------------------------------------------------------------------
*.mobileprovision
*.provisionprofile
*.p12
*.p8
*.cer
*.certSigningRequest
*.pem
*.key
AuthKey_*.p8

# Firebase / Google config (if ever added)
GoogleService-Info.plist
google-services.json

# -----------------------------------------------------------------------------
# Xcode / Swift build artifacts
# -----------------------------------------------------------------------------
# Per-user Xcode state
xcuserdata/
*.xcuserstate
*.xcuserdatad/
*.xcscmblueprint
*.xccheckout

# Xcode 9+ workspace clutter
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/

# Build output
build/
DerivedData/
*.moved-aside
*.hmap
*.ipa
*.dSYM
*.dSYM.zip

# Swift Package Manager
.build/
.swiftpm/
Packages/
Package.resolved

# CocoaPods (defensive — project uses SPM but leave guard rails)
Pods/
*.xcworkspace
!default.xcworkspace

# Carthage (defensive)
Carthage/Build/
Carthage/Checkouts/

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output
fastlane/README.md

# Test & coverage artifacts
*.gcda
*.gcno
*.profdata
*.profraw
coverage/
.coverage/

# -----------------------------------------------------------------------------
# Backend — Supabase Edge Functions (Deno) + tooling
# -----------------------------------------------------------------------------
# Supabase CLI state
.supabase/
supabase/.temp/
supabase/.branches/
supabase/logs/

# Deno
.deno/
deno.lock

# Node / package managers (for eval scripts, tooling)
node_modules/
.pnpm-store/
.yarn/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -----------------------------------------------------------------------------
# AI tooling & session artifacts
# -----------------------------------------------------------------------------
.claude/
.cursor/
.aider*
.continue/
.codeium/
.github-copilot/
docs/superpowers/

# Planning / scratch artifacts — keep the repo free of conversation logs
*.plan.md
CONVERSATION*.md
SCRATCH*.md

# -----------------------------------------------------------------------------
# Test automation & screenshots
# -----------------------------------------------------------------------------
.playwright-mcp/
playwright-report/
test-results/
screenshots/

# -----------------------------------------------------------------------------
# Design mockup scratch (Claude Design handoff bundle — the canonical
# HTML mockups, shared CSS, INDEX.md, and EXTRACTED_TOKENS.md audit live
# in the repo as the visual source of truth; review/scratch/uploads
# subfolders are per-session process artifacts that aren't part of the
# design truth)
# -----------------------------------------------------------------------------
stir-app-design/project/_review/
stir-app-design/project/scratch/
stir-app-design/project/uploads/
stir-app-design/project/DesignMockups/review/

# -----------------------------------------------------------------------------
# Editors & IDEs
# -----------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.iml
*.swp
*.swo
*~
.netrwhist
.project
.settings/

# -----------------------------------------------------------------------------
# OS junk
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# -----------------------------------------------------------------------------
# Logs & temp
# -----------------------------------------------------------------------------
*.log
*.tmp
*.temp
*.bak
*.orig
logs/
tmp/
