{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "lib": ["deno.ns", "dom"]
  },
  "imports": {
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.45.4",
    "jose": "npm:jose@5.9.6",
    "zod": "npm:zod@3.23.8",
    "@std/assert": "jsr:@std/assert@1.0.8",
    "@std/testing/bdd": "jsr:@std/testing@1.0.5/bdd",
    "@std/encoding/hex": "jsr:@std/encoding@1.0.5/hex"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "exclude": ["no-unused-vars"]
    }
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": true,
    "semiColons": true
  }
}
