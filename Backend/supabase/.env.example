# Stir backend environment
# Copy to `.env` in this directory (never committed) and fill in values.
# Local values appear on stdout when you run `supabase start` from Backend/supabase/.

# --- Supabase (auto-injected by `supabase functions serve`; documented for reference) ---
# The Supabase CLI filters SUPABASE_*-prefixed names from .env at runtime
# (reserved prefix), so these must NOT be set here. They're auto-populated
# inside the Edge Runtime for local development:
#   SUPABASE_URL=http://127.0.0.1:54321
#   SUPABASE_ANON_KEY=<from `supabase status`>
#   SUPABASE_SERVICE_ROLE_KEY=<from `supabase status`>
#   SUPABASE_DB_URL=<from `supabase status`>

# JWT signing secret. MUST equal the Supabase project jwt_secret so
# PostgREST validates our custom JWTs and applies RLS natively. Local dev
# value: run `supabase status -o json | jq -r .JWT_SECRET`. Cloud: from
# project settings.
# Named STIR_ (not SUPABASE_) because of the reserved-prefix filter above.
STIR_JWT_SECRET=

# --- AI providers ----------------------------------------------------------
# Read by functions/_shared/gemini.ts at module load to prove env plumbing.
# No Gemini calls are made in step 1 — activated in step 3+.
# NEVER expose this key to any iOS-bound code path.
GEMINI_API_KEY=

# --- Step 5 (RevenueCat webhook; not used in step 1) ----------------------
# REVENUECAT_WEBHOOK_SECRET=

# --- Step 8 (APNs push; not used in step 1) -------------------------------
# APNS_AUTH_KEY_ID=
# APNS_AUTH_KEY_P8=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=

# --- Observability (step 8+; not used in step 1) --------------------------
# POSTHOG_API_KEY=
# SENTRY_DSN=
