# Stir backend environment
# Copy to `.env` in this directory (never committed) and fill in values.
# Local values appear on stdout when you run `supabase start` from Backend/supabase/.

# --- Supabase (auto-injected by `supabase functions serve`; documented for reference) ---
# The Supabase CLI filters SUPABASE_*-prefixed names from .env at runtime
# (reserved prefix), so these must NOT be set here. They're auto-populated
# inside the Edge Runtime for local development:
#   SUPABASE_URL=http://127.0.0.1:54321
#   SUPABASE_ANON_KEY=<from `supabase status`>
#   SUPABASE_SERVICE_ROLE_KEY=<from `supabase status`>
#   SUPABASE_DB_URL=<from `supabase status`>

# JWT signing secret. MUST equal the Supabase project jwt_secret so
# PostgREST validates our custom JWTs and applies RLS natively. Local dev
# value: run `supabase status -o json | jq -r .JWT_SECRET`. Cloud: from
# project settings.
# Named STIR_ (not SUPABASE_) because of the reserved-prefix filter above.
STIR_JWT_SECRET=

# --- AI providers ----------------------------------------------------------
# Read by functions/_shared/gemini.ts at module load to prove env plumbing.
# No Gemini calls are made in step 1 — activated in step 3+. Also used for
# Gemini Live ephemeral-token mint (step 6) via the same x-goog-api-key
# header pattern. Hard requirements per CLAUDE.md §Gemini Live sharp-edges:
#   - Legacy key format (AIzaSy..., 39 chars). New-format AQ.xxx keys
#     fail on /v1alpha/auth_tokens (sharp-edge #18).
#   - Owning GCP project must be on paid tier (sharp-edge #17).
# NEVER expose this key to any iOS-bound code path.
GEMINI_API_KEY=

# --- Step 5 (RevenueCat webhook) ------------------------------------------
# Shared secret sent by RevenueCat as the Authorization header on every
# webhook delivery. MUST match the value configured in the RC dashboard
# (Project Settings → Integrations → Webhooks → Authorization header).
# Handler does a constant-time compare; rotate this value (RC dashboard
# + `supabase secrets set REVENUECAT_WEBHOOK_SECRET=…`) if it ever leaks.
# Minimum length enforced at runtime: 32 chars (raised from 16 in step-5
# review — generate with `openssl rand -hex 32` for a 64-char value).
REVENUECAT_WEBHOOK_SECRET=

# --- Step 8 (APNs push; not used in step 1) -------------------------------
# APNS_AUTH_KEY_ID=
# APNS_AUTH_KEY_P8=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=

# --- Observability (step 8+; not used in step 1) --------------------------
# POSTHOG_API_KEY=
# SENTRY_DSN=
