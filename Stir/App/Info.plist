<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Stir</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.scalinity.stir</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>stir</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>NSCameraUsageDescription</key>
	<string>Stir uses the camera to scan your kitchen and turn ingredients into tonight's dinner options.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Stir listens hands-free during Cook Mode so you can ask questions without touching your phone.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Stir reads recipe screenshots you pick so it can turn them into steps you can cook from.</string>
	<key>NSRemindersUsageDescription</key>
	<string>Stir writes your missing-ingredients list to Reminders so it shows up next time you're at the store.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>
	<key>NSUserActivityTypes</key>
	<array>
		<string>StartNewDinnerSolveIntent</string>
		<string>ShowTonightsIdeaIntent</string>
		<string>AddToGroceryIntent</string>
	</array>
	<key>PostHogPublicAPIKey</key>
	<string>$(POSTHOG_PUBLIC_API_KEY)</string>
	<key>RevenueCatPublicAPIKey</key>
	<string>$(REVENUECAT_PUBLIC_API_KEY)</string>
	<key>SentryDSNPublic</key>
	<string>$(SENTRY_DSN_PUBLIC)</string>
	<key>SupabaseAnonKey</key>
	<string>$(SUPABASE_ANON_KEY)</string>
	<key>SupabaseURL</key>
	<string>$(SUPABASE_URL)</string>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
