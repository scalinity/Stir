#!/bin/bash
#
# Pre-push hook — runs the full xcodebuild test suite before allowing a push.
# Installed by Scripts/install-git-hooks.sh into .git/hooks/pre-push.
#
# Rationale (SCA-181): SCA-176 (PaywallTelemetry source key) and
# SCA-177 (PantryListVM searchText vs effectiveSearchText) both shipped
# to main during parallel sprint-A work without the affected tests being
# run, surfacing only later in the SCA-158 final-verify pass. The full
# StirTests suite takes ~17s — small enough for a pre-push gate.
#
# Behavior:
#   - Runs xcodebuild test -scheme Stir on iPhone 17 Pro simulator.
#   - On any test failure: blocks the push and prints the failed test list.
#   - Skipped if pushing tags only (no commits being pushed).
#   - Skipped if SKIP_PREPUSH_TESTS=1 is set in the environment — escape
#     hatch for emergency hot-fixes that the agent has manually verified.
#
# Skip with care: the whole point of the gate is that "I'll run tests
# locally first" hasn't been reliable. If you need to skip, document why
# in the commit message.

set -euo pipefail

# Bail early on tag-only pushes (no commits being pushed).
if [ -t 0 ]; then
    HAS_COMMITS=1
else
    HAS_COMMITS=0
    while read local_ref local_sha remote_ref remote_sha; do
        # local_sha = '0000...' on a delete; skip.
        if [ "$local_sha" != "0000000000000000000000000000000000000000" ]; then
            HAS_COMMITS=1
            break
        fi
    done
fi

if [ "$HAS_COMMITS" = "0" ]; then
    echo "[pre-push] no commits being pushed; skipping xcodebuild test"
    exit 0
fi

if [ "${SKIP_PREPUSH_TESTS:-0}" = "1" ]; then
    echo "[pre-push] SKIP_PREPUSH_TESTS=1; bypassing xcodebuild test"
    exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "[pre-push] running xcodebuild test on iPhone 17 Pro simulator (~20s)…"

# Capture stderr+stdout into a temp file so we can scan for failures
# while still piping a summary to the user. Quiet mode hides the per-
# file build chatter; we surface only test results + warnings + errors.
TMPLOG="$(mktemp -t stir-prepush-XXXXXX)"
trap 'rm -f "$TMPLOG"' EXIT

if xcodebuild test \
        -scheme Stir \
        -destination 'platform=iOS Simulator,name=iPhone 17 Pro' \
        -quiet \
        > "$TMPLOG" 2>&1; then
    PASSED="$(grep -cE '^Test Case .* passed' "$TMPLOG" || true)"
    echo "[pre-push] ✅ all $PASSED tests passed"
    exit 0
fi

echo "[pre-push] ❌ test failures — push blocked"
echo
echo "--- failed tests ---"
grep -E '^Test Case .* failed' "$TMPLOG" || true
echo
echo "--- last 20 lines of test log ---"
tail -n 20 "$TMPLOG"
echo
echo "Re-run locally with:"
echo "  xcodebuild test -scheme Stir -destination 'platform=iOS Simulator,name=iPhone 17 Pro'"
echo
echo "Emergency override (use sparingly, document in commit):"
echo "  SKIP_PREPUSH_TESTS=1 git push"

exit 1
