#!/bin/bash
#
# Pre-push hook — runs the full xcodebuild test suite + the Deno
# backend test suite before allowing a push. Wired in via
# `git config core.hooksPath scripts/git-hooks/` (see
# scripts/install-git-hooks.sh).
#
# Rationale (SCA-181): SCA-176 (PaywallTelemetry source key) and
# SCA-177 (PantryListVM searchText vs effectiveSearchText) both shipped
# to main during parallel sprint-A work without the affected tests
# being run, surfacing only later in the SCA-158 final-verify pass.
# The full StirTests suite takes ~17s — small enough for a pre-push
# gate.
#
# SCA-220: extended with the deno-test side. Without it, a backend-
# only commit that breaks Backend/supabase/tests/ can land on main
# without the iOS hook noticing — the same red-main hazard SCA-181
# fixed for iOS.
#
# SCA-208: two changes to the iOS gate, both rooted in the same
# Xcode 26.x behavior — `-quiet` strips the "Executed N tests"
# summary line entirely, leaving the log with just three
# IDETestOperationsObserverDebug timing prints and a trailing
# "Testing started". The previous stdout-grep gate had no signal
# under -quiet, so every push fell through to SCA-185's "broken
# gate" failure regardless of actual test outcome.
#
#   1. The success path now reads `xcrun xcresulttool get
#      test-results summary` for the `result` / `passedTests` /
#      `failedTests` / `totalTestCount` fields. Source of truth is
#      the xcresult bundle, not the -quiet stdout log.
#   2. A one-shot retry fires when xcodebuild exits non-zero AND the
#      log carries the SBMainWorkspace
#      "Application failed preflight checks" / "Simulator device
#      failed to launch" substring (wedged sim before test runner
#      installed). Retry flow: `simctl shutdown all` + boot
#      iPhone 17 Pro + 5 s sleep + re-run of `xcodebuild test`
#      exactly ONCE. Retry success emits a distinct
#      `[pre-push] ✅ retried after sim flake` summary so the audit
#      trail captures the event.
#
# Real test failures (xcresult.failedTests > 0) bypass retry. Real
# compile errors (no xcresult bundle produced) also bypass retry —
# the failure path detects the missing bundle and surfaces "compile
# error or sim flake outside SCA-208 substring".
#
# Behavior:
#   - Stage 1: xcodebuild test -scheme Stir on iPhone 17 Pro simulator.
#   - Stage 2: deno test --config Backend/supabase/functions/deno.json
#             --allow-all Backend/supabase/tests/ — IF the local
#             Supabase stack (localhost:54321) is reachable. Otherwise
#             warn loudly and skip; the hook can't run tests against
#             a stack that isn't running, and forcing `supabase start`
#             before every push would be untenable friction.
#   - Skipped on tag-only pushes and on delete-only pushes.
#   - Aborts the push if any test fails OR if iOS reports zero tests
#     (a passing iOS build with zero tests means the gate is broken;
#     SCA-185 review-CR-C2).
#   - Override pattern (matches SCA-188 require-both-vars discipline):
#       SKIP_PREPUSH_TESTS=1 + SKIP_PREPUSH_REASON='…'  → skip BOTH
#       SKIP_PREPUSH_DENO_TESTS=1                       → skip deno only
#                                                          (iOS still runs)

set -euo pipefail

# Match git's ref pattern for "delete" (all-zero local SHA).
ZERO_SHA="0000000000000000000000000000000000000000"

# SCA-186 (review-CR-W1): drop the `[ -t 0 ]` branch entirely. Per
# `man 5 githooks`, git ALWAYS pipes ref-update lines on stdin to
# pre-push, even on tag-only pushes (the lines are tag refs) and
# delete-only pushes (lines have ZERO_SHA). The earlier check was
# inverted and treated TTY-attached manual runs as "has commits",
# which is the opposite of useful. Decide purely on the ref content
# we see on stdin.
HAS_COMMITS=0
while read -r local_ref local_sha _ _; do
    # Skip delete refs (no commits being pushed for this ref).
    [ "$local_sha" = "$ZERO_SHA" ] && continue
    # Skip tag refs (tag-only pushes don't introduce new commits
    # against the test plan; a tagged release was tested at the
    # commit already, by an earlier push to its branch).
    case "$local_ref" in
        refs/tags/*) continue ;;
    esac
    HAS_COMMITS=1
    break
done

if [ "$HAS_COMMITS" = "0" ]; then
    echo "[pre-push] no non-tag commits being pushed; skipping xcodebuild test"
    exit 0
fi

# SCA-188 (review-CR-W4): override requires both env vars. Without
# the reason, the override fails — the audit trail is the reason
# string surfacing in the terminal log + the bash history.
if [ "${SKIP_PREPUSH_TESTS:-0}" = "1" ]; then
    if [ -z "${SKIP_PREPUSH_REASON:-}" ]; then
        echo "[pre-push] SKIP_PREPUSH_TESTS=1 requires SKIP_PREPUSH_REASON='…'"
        echo "  example:"
        echo "    SKIP_PREPUSH_TESTS=1 SKIP_PREPUSH_REASON='sim flake — manually verified 692/692' git push"
        exit 1
    fi
    echo "[pre-push] ⚠️  BYPASSING xcodebuild test — reason: $SKIP_PREPUSH_REASON"
    exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "[pre-push] running xcodebuild test on iPhone 17 Pro simulator (~17s)…"

TMPLOG="$(mktemp -t stir-prepush-XXXXXX)"
trap 'rm -f "$TMPLOG"' EXIT

set +e
xcodebuild test \
    -scheme Stir \
    -destination 'platform=iOS Simulator,name=iPhone 17 Pro' \
    -quiet \
    > "$TMPLOG" 2>&1
EXIT="$?"
set -e

# SCA-208: sim-launch flake detection + one-shot retry. The hook
# previously parsed `Executed N tests` from `-quiet` stdout, but on
# Xcode 26.x `-quiet` drops that line entirely — the entire log is 4
# lines: three IDETestOperationsObserverDebug timing prints and a
# trailing "Testing started". The xcresult bundle is the only
# reliable signal under -quiet, so the gate (success and zero-tests)
# is computed from `xcrun xcresulttool get test-results summary`
# instead. The retry below remains scoped to the original ticket
# shape: EXIT != 0 + the SBMainWorkspace preflight substring → wedged
# sim. Real test failures (non-zero failedTests in xcresult) and real
# compile errors (no xcresult produced at all) bypass retry.
RETRIED_AFTER_SIM_FLAKE=0
if [ "$EXIT" != "0" ] \
   && grep -qE 'Application failed preflight checks|Simulator device failed to launch' "$TMPLOG"; then
    echo "[pre-push] ⚠️  simulator preflight flake detected — resetting sim and retrying once"
    xcrun simctl shutdown all >/dev/null 2>&1 || true
    xcrun simctl boot "iPhone 17 Pro" >/dev/null 2>&1 || true
    sleep 5

    set +e
    xcodebuild test \
        -scheme Stir \
        -destination 'platform=iOS Simulator,name=iPhone 17 Pro' \
        -quiet \
        > "$TMPLOG" 2>&1
    EXIT="$?"
    set -e
    RETRIED_AFTER_SIM_FLAKE=1
fi

# SCA-208: locate the latest xcresult bundle and pull structured
# pass/fail counts. Hoisted so both the success branch and the
# existing SCA-187 failure-extraction path read the same DERIVED.
DERIVED="$(xcodebuild -scheme Stir -showBuildSettings 2>/dev/null \
            | awk -F' = ' '/^[[:space:]]*BUILD_DIR =/ {print $2; exit}' \
            | sed 's|/Build/Products$||')"
LATEST_XCRESULT=""
if [ -n "$DERIVED" ] && [ -d "$DERIVED/Logs/Test" ]; then
    LATEST_XCRESULT="$(ls -td "$DERIVED"/Logs/Test/*.xcresult/ 2>/dev/null | head -1)"
fi

XC_RESULT=""
XC_PASSED=0
XC_FAILED=0
XC_TOTAL=0
if [ -n "$LATEST_XCRESULT" ] && [ -d "$LATEST_XCRESULT" ]; then
    XC_JSON="$(xcrun xcresulttool get test-results summary --path "$LATEST_XCRESULT" 2>/dev/null || true)"
    if [ -n "$XC_JSON" ]; then
        # Single python3 invocation — three roundtrips would parse the
        # same JSON three times. Output: 'result|passed|failed|total'.
        XC_LINE="$(printf '%s' "$XC_JSON" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
    print("|".join([
        str(d.get("result", "")),
        str(d.get("passedTests", 0)),
        str(d.get("failedTests", 0)),
        str(d.get("totalTestCount", 0)),
    ]))
except Exception:
    print("||0|0|0")
' 2>/dev/null || true)"
        XC_RESULT="$(echo "$XC_LINE" | awk -F'|' '{print $1}')"
        XC_PASSED="$(echo "$XC_LINE" | awk -F'|' '{print $2}')"
        XC_FAILED="$(echo "$XC_LINE" | awk -F'|' '{print $3}')"
        XC_TOTAL="$(echo "$XC_LINE" | awk -F'|' '{print $4}')"
    fi
fi

# Success requires both the xcresult `result` field AND a non-zero
# total — the latter preserves SCA-185's broken-gate guard (a build
# that "passes" with zero tests is still a failure).
if [ "$XC_RESULT" = "Passed" ] && [ "${XC_TOTAL:-0}" -gt 0 ]; then
    if [ "$RETRIED_AFTER_SIM_FLAKE" = "1" ]; then
        echo "[pre-push] ✅ retried after sim flake — iOS: $XC_PASSED/$XC_TOTAL tests passed"
    else
        echo "[pre-push] ✅ iOS: $XC_PASSED/$XC_TOTAL tests passed"
    fi
    # iOS green — fall through to the deno test stage (SCA-220).
    IOS_PASSED=1
fi

# Only continue past here on iOS-pass. iOS-fail flows to the failure
# branch below and exits 1 before reaching the deno stage.
if [ "${IOS_PASSED:-0}" = "1" ]; then

# === Stage 2: deno test (SCA-220) =====================================
#
# Run the full Backend/supabase/tests/ suite against the local Supabase
# stack. Skips with a loud warn when the stack isn't reachable — Daniel
# doesn't always have `supabase start` running; forcing it before every
# push would be friction the hook can't justify. SCA-128's edge-runtime
# Path A caveat applies (the running supabase container's mount may not
# be the verify SHA's tree) but for git-hook purposes that's fine —
# we're catching "did backend tests pass at commit author time", not
# "do they pass against this exact tree in CI".

if [ "${SKIP_PREPUSH_DENO_TESTS:-0}" = "1" ]; then
    echo "[pre-push] ⚠️  deno test skipped via SKIP_PREPUSH_DENO_TESTS=1"
    exit 0
fi

# Probe the local supabase stack. Default supabase-cli port is 54321.
# `--max-time 2` keeps the probe under 2s on cold-DNS.
if ! curl -s -o /dev/null --max-time 2 "http://127.0.0.1:54321/rest/v1/"; then
    echo "[pre-push] ⚠️  local Supabase stack not reachable on http://127.0.0.1:54321"
    echo "  skipping deno tests (the hook can't run them against a stopped stack)"
    echo "  start the stack with:    supabase start"
    echo "  or push with explicit:   SKIP_PREPUSH_DENO_TESTS=1 git push"
    exit 0
fi

echo "[pre-push] running deno test against Backend/supabase/tests/ (~30s)…"

DENOLOG="$(mktemp -t stir-prepush-deno-XXXXXX)"
# Append the deno log to the existing iOS log cleanup trap.
trap 'rm -f "$TMPLOG" "$DENOLOG"' EXIT

set +e
deno test \
    --config Backend/supabase/functions/deno.json \
    --allow-all \
    Backend/supabase/tests/ \
    > "$DENOLOG" 2>&1
DENO_EXIT="$?"
set -e

# `deno test` summary line shape:
#   "ok | 124 passed | 0 failed (12s)"
#   "FAILED | 122 passed | 2 failed (12s)"
# Parse the count for the gate-broken-on-zero check (SCA-185 parity).
DENO_SUMMARY="$(grep -E '^(ok|FAILED) \| [0-9]+ passed \| [0-9]+ failed' "$DENOLOG" | tail -1 || true)"
DENO_PASSED="$(echo "$DENO_SUMMARY" | sed -E 's/.*\| ([0-9]+) passed \|.*/\1/' 2>/dev/null || echo "")"
DENO_FAILED="$(echo "$DENO_SUMMARY" | sed -E 's/.*\| ([0-9]+) failed.*/\1/' 2>/dev/null || echo "")"

if [ "$DENO_EXIT" = "0" ] && [ -n "$DENO_PASSED" ] && [ "$DENO_PASSED" -gt 0 ] && [ "${DENO_FAILED:-0}" = "0" ]; then
    echo "[pre-push] ✅ deno: $DENO_SUMMARY"
    exit 0
fi

# Failure path for deno stage.
echo "[pre-push] ❌ push blocked — deno tests failed"
echo
if [ "$DENO_EXIT" = "0" ] && [ "${DENO_PASSED:-0}" = "0" ]; then
    echo "  reason: deno test exited 0 but ran 0 tests — gate broken."
elif [ -n "$DENO_SUMMARY" ]; then
    echo "  reason: $DENO_SUMMARY"
else
    echo "  reason: deno test exited $DENO_EXIT with no parseable summary line"
fi
echo
echo "--- last 80 lines of deno test log ---"
tail -n 80 "$DENOLOG"
echo
echo "Re-run locally with:"
echo "  cd Backend/supabase && deno test --config functions/deno.json --allow-all tests/"
echo
echo "Emergency override (requires reason; documented in commit):"
echo "  SKIP_PREPUSH_TESTS=1 SKIP_PREPUSH_REASON='…' git push"
echo "  (or skip ONLY deno: SKIP_PREPUSH_DENO_TESTS=1 git push)"
exit 1

fi # end IOS_PASSED guard

# Below here only reachable on iOS failure — falls into the existing
# iOS-failure reporting block.

# Failure path. Reason out which kind and what failed.
echo "[pre-push] ❌ push blocked"
echo

if [ -z "$LATEST_XCRESULT" ]; then
    # No xcresult means xcodebuild never produced one — typically a
    # compile error before testing started, or a sim-launch flake that
    # didn't match the SCA-208 substring (so retry didn't fire). The
    # log tail has the real signal in either case.
    echo "  reason: xcodebuild exited $EXIT with no xcresult bundle produced"
    echo "  (likely a compile error, missing dependency, or sim flake outside the SCA-208 substring)"
elif [ "$XC_RESULT" = "Passed" ] && [ "${XC_TOTAL:-0}" = "0" ]; then
    echo "  reason: xcresult reports Passed but totalTestCount=0 — gate broken."
    echo "  investigate the test scheme, -only-testing filter, or the simulator state."
elif [ "${XC_FAILED:-0}" -gt 0 ]; then
    echo "  reason: $XC_FAILED of $XC_TOTAL tests failed (xcresult.result=$XC_RESULT)"
    echo

    # SCA-187 (review-CR-W2): -quiet strips per-`Test Case` lines, so
    # the in-log grep is empty for failed-test enumeration. The
    # xcresult bundle has the structural data — DERIVED + LATEST_XCRESULT
    # are already hoisted above.
    echo "--- failures (from xcresult) ---"
    xcrun xcresulttool get test-results summary --path "$LATEST_XCRESULT" 2>/dev/null \
        | python3 -c "
import json, sys
try:
    data = json.load(sys.stdin)
    failures = data.get('testFailures', []) or []
    if not failures:
        print('  (no structured failure list — see tail below)')
    for f in failures[:20]:
        ident = f.get('testIdentifierString', '?')
        text = (f.get('failureText') or '').replace(chr(10), ' ')[:180]
        print(f'  - {ident}')
        if text:
            print(f'    -> {text}')
except Exception as exc:
    print(f'  (xcresulttool parse failed: {exc})')
" 2>/dev/null || echo "  (xcresulttool extraction failed — see tail)"
else
    echo "  reason: xcresult.result=$XC_RESULT (passed=$XC_PASSED failed=$XC_FAILED total=$XC_TOTAL exit=$EXIT)"
fi

echo
echo "--- last 60 lines of test log ---"
tail -n 60 "$TMPLOG"
echo
echo "Re-run locally with:"
echo "  xcodebuild test -scheme Stir -destination 'platform=iOS Simulator,name=iPhone 17 Pro'"
echo
echo "Emergency override (requires reason; documented in commit):"
echo "  SKIP_PREPUSH_TESTS=1 SKIP_PREPUSH_REASON='…' git push"

exit 1
